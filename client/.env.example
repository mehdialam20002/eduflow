# Copy this file to client/.env.local. Next.js reads .env.local only when it starts,
# so stop and start `npm run dev` after every change here.

# Base address of the API, with /api/v1. The browser calls this directly.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Address of this web app.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shows a "LOCAL" badge in the header, so you never mix up environments.
NEXT_PUBLIC_APP_ENV=local
# Root domain for tenant subdomains. Production: eduflow.app
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Shows the app shell with a clearly marked sample session while the login route
# does not exist yet. Set it to false on the day P-09 lands, and never set it to
# true outside your laptop.
NEXT_PUBLIC_PREVIEW_SESSION=true

# Name of the httpOnly session cookie that the API sets. Only src/middleware.ts
# reads it, on the Next.js server, so it carries no NEXT_PUBLIC_ prefix.
SESSION_COOKIE_NAME=eduflow_rt

# Stripe publishable key, test mode. Needed from P-32 only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Browser error reporting. Empty locally.
NEXT_PUBLIC_SENTRY_DSN=
# Product analytics. Empty locally, so your own clicks do not pollute the data.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
