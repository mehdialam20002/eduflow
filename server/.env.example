# EduFlow API and worker. Copy this file to server/.env and change the marked values.
# A new variable is added in three places in the same commit: src/config/env.ts, this file
# and docs/blueprint/90-appendix-environment-variables-and-commands.md.

# ---------- Core ----------
NODE_ENV=development
APP_ENV=local
APP_VERSION=dev
PORT=4000
LOG_LEVEL=debug
# Address of the web app. Used in email links and redirects.
APP_URL=http://localhost:3000
# This API's own public address. Use your tunnel URL while testing webhooks.
API_URL=http://localhost:4000
# Every *.{ROOT_DOMAIN} origin is allowed by CORS.
ROOT_DOMAIN=localhost
# Comma-separated extra origins. Empty in production.
CORS_EXTRA_ORIGINS=http://localhost:3000
# 1 behind Railway or a load balancer, so req.ip is the real client IP.
TRUST_PROXY=0

# ---------- Database ----------
# Runtime role. From day 6 this is eduflow_app, the role row-level security applies to.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/eduflow_dev?schema=public
# Owner role. Used only by prisma migrate, the seed and Prisma Studio.
DATABASE_ADMIN_URL=postgresql://postgres:CHANGE_ME@localhost:5432/eduflow_dev?schema=public

# ---------- Redis, cache and queues ----------
# Leave this empty until Redis runs. The API works without it; background jobs do not.
REDIS_URL=
QUEUE_PREFIX=eduflow-local

# ---------- Auth ----------
# Both secrets need at least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=local_access_secret_0123456789abcdef_change_me
JWT_REFRESH_SECRET=local_refresh_secret_0123456789abcdef_change_me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=http://localhost:4000
JWT_AUDIENCE=eduflow-api
REFRESH_COOKIE_NAME=ef_rt_local
# Empty on localhost. In production: .eduflow.app
COOKIE_DOMAIN=
COOKIE_SECURE=false
# AES-256-GCM key for encrypted columns. 64 hex characters. Keep a written backup.
FIELD_ENCRYPTION_KEY=

# ---------- Rate limits (canon values) ----------
RATE_LIMIT_USER_PER_MIN=100
RATE_LIMIT_ORG_PER_MIN=1000
RATE_LIMIT_PUBLIC_PER_MIN=30
RATE_LIMIT_LOGIN_PER_15MIN=5

# ---------- Defaults for a new organization ----------
DEFAULT_COUNTRY=IN
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata

# ---------- Seed (local and staging only) ----------
SEED_DEMO_PASSWORD=EduFlow@Local123

# ---------- Files (S3) ----------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_UPLOADS=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# ---------- Email ----------
MAIL_TRANSPORT=smtp
MAIL_FROM=EduFlow Local <no-reply@eduflow.app>
SMTP_HOST=localhost
SMTP_PORT=1025
SES_REGION=ap-south-1

# ---------- Message safety switch ----------
# log writes messages to the terminal, allowlist sends only to testers, live sends to everyone.
MESSAGING_MODE=log
MESSAGING_ALLOWLIST=

# ---------- Payments (test mode) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------- WhatsApp, SMS ----------
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- Monitoring ----------
# Empty locally, so your own bugs do not fill Sentry.
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=
