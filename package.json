{
  "name": "eduflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EduFlow - multi-tenant SaaS ERP for schools and coaching institutes.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "dev:worker": "npm run dev:worker -w server",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w client --if-present",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:migrate": "npm run -w server db:migrate",
    "db:seed": "npm run -w server db:seed",
    "db:studio": "npm run -w server db:studio",
    "db:reset": "npm run -w server db:reset",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose stop",
    "doctor": "node scripts/doctor.mjs",
    "setup": "node scripts/setup.mjs",
    "sync:schema": "node scripts/sync-schema.mjs",
    "check:schema-sync": "node scripts/sync-schema.mjs --check",
    "gen:constants": "python docs/build/gen_shared_constants.py"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
